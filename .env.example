# Development example. Supply database URLs and a persistent KEK in a local .env.
ORBIT_AUTH_MODE=dev
ORBIT_PERSONAL_TENANTS=true
ORBIT_HTTP_ADDR=127.0.0.1:55442
ORBIT_PUBLIC_ORIGIN=http://127.0.0.1:55442
ORBIT_CORS_ORIGINS=
ORBIT_SIGNING_KEY_FILE=.orbit-data/signing.key
ORBIT_CAPABILITY_KEY_FILE=.orbit-data/capability.key
ORBIT_CAPABILITY_KEY_ID=1
ORBIT_CAPABILITY_PUBLIC_KEYS=
ORBIT_SECRETS_KEY_VERSION=1
# Generate once: openssl rand -base64 32; persist securely, do not rotate on restart.
ORBIT_SECRETS_KEK=
ORBIT_SECRETS_KEK_PREVIOUS=
ORBIT_DATABASE_URL=
ORBIT_ADMIN_DATABASE_URL=

# Asset storage: a provisioned bucket and control service credentials.
ORBIT_OBJECT_ENDPOINT=127.0.0.1:59100
ORBIT_OBJECT_BUCKET=orbit-v2
ORBIT_OBJECT_ACCESS_KEY=
ORBIT_OBJECT_SECRET_KEY=
ORBIT_OBJECT_TLS=false
ORBIT_ASSET_UPLOAD_CONCURRENCY=2
ORBIT_ASSET_SIGNING_KEY_FILE=.orbit-data/assets.key
ORBIT_ASSET_SIGNING_KEY_ID=1
ORBIT_ASSET_PUBLIC_KEYS=
ORBIT_TEMPORAL_ADDRESS=127.0.0.1:57233
ORBIT_TEMPORAL_NAMESPACE=orbit-dev
ORBIT_TEMPORAL_TLS=false
ORBIT_TEMPORAL_TLS_CA_FILE=
ORBIT_TEMPORAL_TLS_CERT_FILE=
ORBIT_TEMPORAL_TLS_KEY_FILE=
ORBIT_TEMPORAL_TLS_SERVER_NAME=
