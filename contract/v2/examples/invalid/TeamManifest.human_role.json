{
  "schema": "orbit.team/v1",
  "name": "research-squad",
  "version": "2.0.0",
  "description": "Researches, cross-checks and writes a report.",
  "roles": [
    {
      "name": "leader",
      "role": "leader",
      "agent": "."
    },
    {
      "name": "researcher",
      "role": "teammate",
      "agent": "acme/web-researcher@^1.2",
      "count": 2
    },
    {
      "name": "reviewer",
      "role": "reviewer",
      "agent": "./members/reviewer"
    },
    {
      "name": "owner",
      "role": "human",
      "agent": "."
    }
  ],
  "dispatch": "scheduled",
  "maxParallelMembers": 3,
  "review": {
    "mode": "veto"
  },
  "sharedSkills": [
    {
      "id": "public/citation-check",
      "version": "^1.0"
    }
  ]
}
