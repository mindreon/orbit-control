{
  "schema": "orbit.agent/v2",
  "name": "contract-assistant",
  "version": "1.3.0",
  "displayName": {
    "zh": "合同助手",
    "en": "Contract Assistant"
  },
  "description": "Compares contract clauses and flags risks.",
  "tags": ["legal", "office"],
  "model": {
    "profile": "reasoning-default",
    "fallback": ["fast-default"]
  },
  "tools": {
    "builtin": ["read_file", "write_file", "shell", "web_fetch"]
  },
  "rails": [
    {
      "type": "context_compression"
    },
    {
      "type": "circuit_breaker",
      "config": {
        "max_repeats": 4
      }
    }
  ],
  "limits": {
    "maxIterationsPerRun": 200,
    "defaultRunBudgetCredits": 50
  },
  "permissions": {
    "network": {
      "egress": ["*.acme-internal.com", "api.example-ocr.com"]
    },
    "secrets": [
      {
        "name": "OCR_API_KEY",
        "scope": "tenant"
      }
    ],
    "dataScopes": ["session_files", "workspace_knowledge:read"],
    "effectClasses": ["read_only", "sandbox_write", "external_write"],
    "sandbox": {
      "profile": "office-standard"
    }
  },
  "compat": {
    "kernel": "openjiuwen>=0.1.19,<0.2",
    "platform": ">=1.0"
  }
}
