{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.mindreon.com/contract/v2/segment_input.json",
  "description": "Input of the RunAgentSegment activity.",
  "x-exports": [
    "SegmentInput"
  ],
  "$defs": {
    "SegmentInput": {
      "description": "Input of the RunAgentSegment activity: one bounded slice of an agent run, which the worker executes as a single DeepAgent invocation. Kept small (under 8 KiB); anything large is passed by reference. capability_token is explicitly forbidden: workers fetch it out of band so secrets never enter Temporal history.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "session_id",
        "run_id",
        "member",
        "seq",
        "agent_session_key",
        "expected_checkpoint_version",
        "lock",
        "input",
        "limits",
        "budget_notice",
        "sandbox",
        "event_subject",
        "v",
        "workspace_id",
        "principal_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Tenant that owns the run."
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "description": "Session the run belongs to."
        },
        "run_id": {
          "type": "string",
          "format": "uuid",
          "description": "Run this segment belongs to."
        },
        "member": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "description": "Who executes the segment: main for a single-agent run, otherwise the roster name."
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Segment number within the (run, member), starting at 1. With run_id and member it is the idempotency key of the segment."
        },
        "agent_session_key": {
          "type": "string",
          "minLength": 1,
          "description": "Key of the agent conversation state (checkpoint) this segment continues; one per (run, member) or per session."
        },
        "expected_checkpoint_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Checkpoint version the segment must start from. The commit is a compare-and-swap to this value plus one."
        },
        "lock": {
          "$ref": "#/$defs/SegmentLockRef"
        },
        "input": {
          "$ref": "#/$defs/SegmentTurn"
        },
        "steer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SteerItem"
          },
          "description": "Course corrections from the user that arrived while the run was active, oldest first, injected before the model call.",
          "default": []
        },
        "mailbox": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MailboxMessage"
          },
          "description": "Team messages delivered to this member since its last segment, oldest first. Present only for team members.",
          "default": []
        },
        "limits": {
          "$ref": "#/$defs/SegmentLimits"
        },
        "budget_notice": {
          "$ref": "#/$defs/BudgetNotice"
        },
        "sandbox": {
          "$ref": "#/$defs/SegmentSandbox"
        },
        "event_subject": {
          "type": "string",
          "minLength": 1,
          "description": "NATS subject the worker publishes run events to, run.<tenant>.<session>.<run>."
        },
        "team": {
          "$ref": "#/$defs/TeamContext"
        },
        "trace": {
          "$ref": "#/$defs/SegmentTrace"
        },
        "v": {
          "type": "integer",
          "minimum": 1,
          "description": "Wire protocol version; currently 1.",
          "const": 1
        },
        "workspace_id": {
          "type": "string",
          "description": "Workspace of the run, used for scoped authorization.",
          "format": "uuid"
        },
        "principal_id": {
          "type": "string",
          "description": "Principal initiating the run, used for user grants.",
          "format": "uuid"
        }
      },
      "x-extra": "ignore",
      "not": {
        "required": [
          "capability_token"
        ]
      }
    },
    "SegmentLockRef": {
      "description": "The run lock the segment executes: the exact resolved versions of the agent, its skills and MCP servers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Lock identifier, the lock_id of the RunLock.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Digest of the lock content; the worker compiles and caches by it."
        }
      },
      "x-extra": "ignore"
    },
    "SegmentTurnKind": {
      "description": "What starts the segment: a new user message, the answer to an interaction that parked the run, a follow-up (steer or mailbox delivery), or a plain continuation after a yield. compact: compact the context and commit a new checkpoint.",
      "enum": [
        "user_message",
        "interactive_input",
        "follow_up",
        "continue",
        "compact"
      ]
    },
    "SegmentTurn": {
      "description": "The trigger of the segment. user_message needs content_ref or text; interactive_input needs interaction_id and decision.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/SegmentTurnKind"
        },
        "content_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Object store reference of the message content when it is too large to inline."
        },
        "text": {
          "type": "string",
          "description": "Inline message text."
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1,
          "description": "Interaction being answered.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "decision": {
          "$ref": "interaction.json#/$defs/Decision"
        },
        "attachments": {
          "type": "array",
          "description": "Files attached to user_message.",
          "items": {
            "$ref": "#/$defs/MessageAttachment"
          },
          "default": []
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "user_message"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "content_ref"
                ]
              },
              {
                "required": [
                  "text"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "interactive_input"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "interaction_id",
              "decision"
            ]
          }
        }
      ],
      "x-extra": "ignore"
    },
    "SteerItem": {
      "description": "One steering message from the user.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Object store reference of the content."
        },
        "text": {
          "type": "string",
          "description": "Inline text."
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "text"
              ]
            }
          },
          "then": {
            "required": [
              "content_ref"
            ]
          }
        }
      ],
      "x-extra": "ignore"
    },
    "MailboxMessage": {
      "description": "A message another team member (or the leader) sent to this member.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "from",
        "sent_at"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "description": "Message identifier, unique within the team run.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "description": "Roster name of the sender."
        },
        "text": {
          "type": "string",
          "description": "Inline text."
        },
        "content_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Object store reference of the content when it is too large to inline."
        },
        "sent_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the message was sent."
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "text"
              ]
            }
          },
          "then": {
            "required": [
              "content_ref"
            ]
          }
        }
      ],
      "x-extra": "ignore"
    },
    "SegmentLimits": {
      "description": "Bounds of one segment; the segment yields when any of them is reached.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_iterations",
        "max_wall_seconds",
        "segment_budget_millicredits",
        "remaining_run_millicredits"
      ],
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum ReAct iterations in the segment."
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Wall-clock bound of the segment; the worker stops the agent before the activity timeout."
        },
        "segment_budget_millicredits": {
          "type": "integer",
          "minimum": 0,
          "description": "Integer millicredits (1000 = 1 credit). Credits this segment may spend before it yields with budget_soft.",
          "maximum": 9007199254740991
        },
        "remaining_run_millicredits": {
          "type": "integer",
          "minimum": 0,
          "description": "Integer millicredits (1000 = 1 credit). Credits left in the run budget at the start of the segment.",
          "maximum": 9007199254740991
        }
      },
      "x-extra": "ignore"
    },
    "BudgetNotice": {
      "description": "none, or soft_warning once the run has consumed its warning share of the budget; the agent is told to wrap up.",
      "enum": [
        "none",
        "soft_warning"
      ]
    },
    "SegmentSandbox": {
      "description": "The sandbox lease the segment runs its tools in, acquired by the workflow before the segment.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "sandbox_id",
        "isolation_key"
      ],
      "properties": {
        "provider": {
          "$ref": "sandbox.json#/$defs/SandboxProvider"
        },
        "sandbox_id": {
          "type": "string",
          "minLength": 1,
          "description": "Provider identifier of the sandbox.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "isolated_session_id": {
          "type": "string",
          "minLength": 1,
          "description": "Isolated session inside a shared sandbox, used for team members.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "isolation_key": {
          "$ref": "common.json#/$defs/IsolationKey"
        }
      },
      "x-extra": "ignore"
    },
    "TeamTaskBrief": {
      "description": "The task a teammate or reviewer works on in this segment.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "description"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "description": "Task identifier on the team board.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Short title."
        },
        "description": {
          "type": "string",
          "description": "What to do and what done looks like."
        },
        "spec_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Object store reference of a longer specification."
        },
        "narrowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tools the leader restricted the task to; empty means the member's full tool set. It can only narrow, never widen.",
          "default": []
        }
      },
      "x-extra": "ignore"
    },
    "TeamContext": {
      "description": "Present when the segment belongs to a team run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_workflow_id",
        "role"
      ],
      "properties": {
        "team_workflow_id": {
          "type": "string",
          "minLength": 1,
          "description": "Workflow ID of the TeamRunWorkflow; team tools call its Updates.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "role": {
          "$ref": "team_updates.json#/$defs/TeamRole"
        },
        "task": {
          "$ref": "#/$defs/TeamTaskBrief"
        }
      },
      "x-extra": "ignore"
    },
    "SegmentTrace": {
      "description": "Trace context of the activity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traceparent"
      ],
      "properties": {
        "traceparent": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
          "description": "W3C traceparent header value."
        }
      },
      "x-extra": "ignore"
    },
    "MessageAttachment": {
      "type": "object",
      "description": "An uploaded file reference; no file bytes in Temporal history.",
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "type": "string",
          "description": "Uploaded file identifier.",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "description": "Display file name.",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "description": "Media type.",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes."
        }
      },
      "required": [
        "file_id",
        "name",
        "media_type",
        "size_bytes"
      ],
      "x-extra": "ignore"
    }
  }
}
