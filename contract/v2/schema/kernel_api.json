{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.mindreon.com/contract/v2/kernel_api.json",
  "description": "Request and response bodies of the control internal API (/internal/v1/*) that the worker calls with the run capability token.",
  "x-exports": [
    "GetLockResponse",
    "ModelCredentials",
    "PolicySnapshot",
    "SecretGrant",
    "TokenRequest",
    "TokenResponse",
    "SecretGrantRequest",
    "SecretGrantResponse",
    "CheckpointKeyResponse",
    "UsageItem",
    "UsageReport",
    "UsageReportResponse",
    "TeamErrorCode",
    "ScheduleCreateRequest",
    "ScheduleView",
    "ScheduleListResponse",
    "ScheduleErrorCode"
  ],
  "$defs": {
    "LockFileContent": {
      "description": "How to obtain the content of one locked file: a short-lived download URL, or the text inline when the file is small text. Exactly one of blob_url and text is present.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "version",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "$ref": "lock.json#/$defs/AssetKind"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Asset reference of the entry the file belongs to."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the entry the file belongs to."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path of the file inside the bundle."
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 file content digest as sha256:<64 lowercase hex>."
        },
        "blob_url": {
          "type": "string",
          "description": "Pre-signed object store URL of the content.",
          "pattern": "^https?://",
          "x-sensitive": true
        },
        "text": {
          "type": "string",
          "description": "The content itself, for small UTF-8 text files."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "blob_url"
            ]
          },
          "then": {
            "properties": {
              "text": false
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "blob_url"
              ]
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        }
      ],
      "x-extra": "ignore"
    },
    "GetLockResponse": {
      "description": "A run lock and the means to fetch every file in it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock"
      ],
      "properties": {
        "lock": {
          "$ref": "lock.json#/$defs/RunLock"
        },
        "contents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LockFileContent"
          },
          "description": "One element per file of every entry of the lock.",
          "default": []
        }
      },
      "x-extra": "ignore"
    },
    "ModelCredentials": {
      "description": "Endpoint and short-lived key of an OpenAI-compatible model API, issued per segment from the tenant model profile. It never enters Temporal history.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "model",
        "api_key",
        "expires_at",
        "pricing"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "description": "Base URL of the API.",
          "pattern": "^https?://"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model name to send."
        },
        "api_key": {
          "type": "string",
          "minLength": 1,
          "description": "Bearer key for the API.",
          "x-sensitive": true
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the key stops working."
        },
        "params": {
          "type": "object",
          "description": "Default request parameters of the profile, such as temperature or max_tokens.",
          "x-extra": "ignore"
        },
        "pricing": {
          "$ref": "#/$defs/ModelPricing"
        },
        "context_window": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum context tokens."
        }
      },
      "x-extra": "ignore"
    },
    "ToolDecision": {
      "description": "What the policy says about a call: allow, ask for approval, or deny.",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "GrantScope": {
      "description": "How far a grant of allow_always reaches: the session, the user across sessions, or the whole workspace.",
      "enum": [
        "session",
        "user",
        "workspace"
      ]
    },
    "ToolRule": {
      "description": "A policy rule for a tool.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "decision"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "description": "Tool name."
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Glob using Go path.Match semantics: * matches zero or more non-slash characters; ? matches one non-slash Unicode character; [ranges], [^ranges] and backslash escapes follow path.Match. Matches the entire argument string (RFC 8785 JCS for structured arguments). Invalid patterns are errors."
        },
        "decision": {
          "$ref": "#/$defs/ToolDecision"
        }
      },
      "x-extra": "ignore"
    },
    "PermissionGrant": {
      "description": "A standing permission a user gave with allow_always or allow_session.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "scope",
        "expires_at",
        "interaction_id"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "description": "Tool name."
        },
        "arg_pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Glob using Go path.Match semantics: * matches zero or more non-slash characters; ? matches one non-slash Unicode character; [ranges], [^ranges] and backslash escapes follow path.Match. Matches the entire argument string (RFC 8785 JCS for structured arguments). Invalid patterns are errors."
        },
        "scope": {
          "$ref": "#/$defs/GrantScope"
        },
        "expires_at": {
          "type": "string",
          "description": "Grant expiration.",
          "format": "date-time"
        },
        "interaction_id": {
          "type": "string",
          "description": "Human decision that authorized this grant.",
          "format": "uuid"
        }
      },
      "x-extra": "ignore"
    },
    "PolicySnapshot": {
      "description": "Tool policy of the run as of the start of a segment: the tenant and workspace rules and the grants that turn ask into allow. A grant never overrides deny.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "tool_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolRule"
          },
          "description": "Rules in precedence order.",
          "default": []
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermissionGrant"
          },
          "description": "Grants in force for the run's principal.",
          "default": []
        }
      },
      "x-extra": "ignore"
    },
    "SecretGrant": {
      "description": "A short-lived grant of a secret value, issued for a name the lock declares.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "expires_at"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Secret name."
        },
        "value": {
          "type": "string",
          "description": "The secret value. It must not be logged, put in events or in Temporal payloads.",
          "x-sensitive": true
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the grant stops being valid."
        }
      },
      "x-extra": "ignore"
    },
    "TokenPurpose": {
      "enum": [
        "segment",
        "sandbox"
      ],
      "description": "Scope of the capability."
    },
    "TokenRequest": {
      "type": "object",
      "description": "POST /internal/v1/tokens authenticated by Authorization: Bearer <ORBIT_WORKER_SERVICE_TOKEN>. Internal listener only, no edge route. Production uses internal listener + mTLS (R1 service credentials, R2 mTLS). For purpose=segment, member/seq/attempt are required and control checks the active run and current uncommitted segment; committed segments are rejected without a revocation list. Worker may renew within a segment. For purpose=sandbox, lease_id is required and binds the isolation key; control checks the active lease and run/session ownership, without requiring member/seq/attempt.",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "description": "Tenant used for the RLS run lookup.",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "description": "Running run.",
          "format": "uuid"
        },
        "member": {
          "$ref": "team_updates.json#/$defs/MemberName"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Current uncommitted segment."
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "description": "Temporal activity attempt."
        },
        "purpose": {
          "$ref": "#/$defs/TokenPurpose"
        },
        "lease_id": {
          "type": "string",
          "description": "Sandbox isolation key bound to the capability.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        }
      },
      "required": [
        "tenant_id",
        "run_id",
        "purpose"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "segment"
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "required": [
              "member",
              "seq",
              "attempt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "sandbox"
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "required": [
              "lease_id"
            ]
          }
        }
      ],
      "x-extra": "ignore"
    },
    "TokenResponse": {
      "type": "object",
      "description": "Five-minute capability binding tenant/run/purpose plus member/seq/attempt for segments or lease_id for sandboxes; never record in Temporal history.",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "description": "Bearer capability.",
          "minLength": 1,
          "x-sensitive": true
        },
        "expires_at": {
          "type": "string",
          "description": "Token expires five minutes after issue.",
          "format": "date-time"
        }
      },
      "required": [
        "token",
        "expires_at"
      ],
      "x-extra": "ignore"
    },
    "ModelPricing": {
      "type": "object",
      "description": "Millicredits per million tokens. Cost per token category = ceil(tokens * price / 1000000); sum category costs using integers.",
      "additionalProperties": false,
      "properties": {
        "input_per_mtok_millicredits": {
          "type": "integer",
          "minimum": 0,
          "description": "Price per million input tokens.",
          "maximum": 9007199254740991
        },
        "output_per_mtok_millicredits": {
          "type": "integer",
          "minimum": 0,
          "description": "Price per million output tokens.",
          "maximum": 9007199254740991
        },
        "cache_read_per_mtok_millicredits": {
          "type": "integer",
          "minimum": 0,
          "description": "Price per million cache_read tokens.",
          "maximum": 9007199254740991
        },
        "cache_write_per_mtok_millicredits": {
          "type": "integer",
          "minimum": 0,
          "description": "Price per million cache_write tokens.",
          "maximum": 9007199254740991
        }
      },
      "required": [
        "input_per_mtok_millicredits",
        "output_per_mtok_millicredits",
        "cache_read_per_mtok_millicredits",
        "cache_write_per_mtok_millicredits"
      ],
      "x-extra": "ignore"
    },
    "SecretGrantRequest": {
      "type": "object",
      "description": "Fetch declared secrets using a segment token. Sandbox credentials require purpose=sandbox and lease_id; R1 does not inject sandbox secrets (D19).",
      "additionalProperties": false,
      "properties": {
        "names": {
          "type": "array",
          "description": "Declared secret names.",
          "items": {
            "type": "string",
            "description": "Secret name.",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "default": []
        }
      },
      "required": [],
      "x-extra": "ignore"
    },
    "SecretGrantResponse": {
      "type": "object",
      "description": "Short-lived secret grants, never store in history.",
      "additionalProperties": false,
      "properties": {
        "grants": {
          "type": "array",
          "description": "Granted secrets.",
          "items": {
            "$ref": "#/$defs/SecretGrant"
          },
          "default": []
        }
      },
      "required": [],
      "x-extra": "ignore"
    },
    "CheckpointKeyResponse": {
      "type": "object",
      "description": "Key for encrypted checkpoints; not a Temporal payload.",
      "additionalProperties": false,
      "properties": {
        "key_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Key version."
        },
        "key": {
          "type": "string",
          "description": "Base64 checkpoint key.",
          "minLength": 1,
          "x-sensitive": true
        }
      },
      "required": [
        "key_version",
        "key"
      ],
      "x-extra": "ignore"
    },
    "UsageItem": {
      "type": "object",
      "description": "One model usage ledger item, idempotently booked by control.",
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "type": "string",
          "description": "Stable key across retries.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "model": {
          "type": "string",
          "description": "Model name.",
          "minLength": 1
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Token count."
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Token count."
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Token count."
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Token count."
        },
        "occurred_at": {
          "type": "string",
          "description": "Model request completion.",
          "format": "date-time"
        }
      },
      "required": [
        "idempotency_key",
        "model",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "occurred_at"
      ],
      "x-extra": "ignore"
    },
    "UsageReport": {
      "type": "object",
      "description": "Report usage; control prices it using ModelPricing.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "description": "Model usage observations.",
          "items": {
            "$ref": "#/$defs/UsageItem"
          },
          "default": []
        }
      },
      "required": [],
      "x-extra": "ignore"
    },
    "UsageReportResponse": {
      "type": "object",
      "description": "Authoritative run usage after deduplication.",
      "additionalProperties": false,
      "properties": {
        "run_used_millicredits": {
          "type": "integer",
          "minimum": 0,
          "description": "Cumulative booked run cost.",
          "maximum": 9007199254740991
        }
      },
      "required": [
        "run_used_millicredits"
      ],
      "x-extra": "ignore"
    },
    "TeamErrorCode": {
      "description": "HTTP error codes returned by team kernel API operations; not Temporal ApplicationError types.",
      "enum": [
        "TEAM_NOT_LEADER",
        "TEAM_NOT_ASSIGNEE",
        "TEAM_NOT_REVIEWER",
        "TEAM_NOT_IN_TURN",
        "TEAM_UNKNOWN_TASK",
        "TEAM_UNKNOWN_MEMBER",
        "TEAM_BAD_TRANSITION",
        "TEAM_MAILBOX_FULL",
        "TEAM_TOO_MANY_TASKS",
        "TEAM_TEXT_TOO_LONG",
        "TEAM_FINISHED",
        "TEAM_UPDATE_TIMEOUT"
      ]
    },
    "ScheduleCreateRequest": {
      "description": "Create a schedule as the run principal in the session workspace.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "cron",
        "timezone",
        "entry_ref",
        "prompt",
        "budget_millicredits",
        "request_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Schedule display name, 1\u2013128 characters.",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "description": "What the schedule is for; at most 1024 characters.",
          "maxLength": 1024
        },
        "cron": {
          "type": "string",
          "description": "Standard five-field cron; minimum interval 5 minutes, validated by control.",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone name; empty and Local are rejected by control.",
          "minLength": 1
        },
        "entry_ref": {
          "type": "string",
          "description": "Agent or team asset reference; control resolves its kind and permissions.",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "description": "Run prompt; nonempty and at most 32768 UTF-8 bytes, authoritatively validated by control.",
          "minLength": 1,
          "maxLength": 32768
        },
        "budget_millicredits": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9007199254740991,
          "description": "Budget per firing in integer millicredits; at least 1000."
        },
        "overlap_policy": {
          "$ref": "#/$defs/ScheduleOverlapPolicy",
          "description": "Overlap handling; defaults to skip.",
          "default": "skip"
        },
        "catchup_window_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400,
          "default": 3600,
          "description": "Catchup window in seconds; defaults to 3600."
        },
        "request_id": {
          "type": "string",
          "description": "Effect key for idempotent creation within the run.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        }
      },
      "x-extra": "ignore"
    },
    "ScheduleView": {
      "description": "Public schedule configuration and lifecycle state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "cron",
        "timezone",
        "entry_ref",
        "prompt",
        "budget_millicredits",
        "overlap_policy",
        "catchup_window_seconds",
        "id",
        "workspace_id",
        "owner_id",
        "entry_kind",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Schedule display name, 1\u2013128 characters.",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "description": "What the schedule is for; at most 1024 characters.",
          "maxLength": 1024
        },
        "cron": {
          "type": "string",
          "description": "Standard five-field cron; minimum interval 5 minutes, validated by control.",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone name; empty and Local are rejected by control.",
          "minLength": 1
        },
        "entry_ref": {
          "type": "string",
          "description": "Agent or team asset reference; control resolves its kind and permissions.",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "description": "Run prompt; nonempty and at most 32768 UTF-8 bytes, authoritatively validated by control.",
          "minLength": 1,
          "maxLength": 32768
        },
        "budget_millicredits": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9007199254740991,
          "description": "Budget per firing in integer millicredits; at least 1000."
        },
        "overlap_policy": {
          "$ref": "#/$defs/ScheduleOverlapPolicy",
          "description": "Overlap handling."
        },
        "catchup_window_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400,
          "description": "Catchup window in seconds."
        },
        "id": {
          "type": "string",
          "description": "Schedule identifier.",
          "format": "uuid"
        },
        "workspace_id": {
          "type": "string",
          "description": "Workspace containing the schedule.",
          "format": "uuid"
        },
        "owner_id": {
          "type": "string",
          "description": "Principal whose identity and permissions apply at each firing.",
          "format": "uuid"
        },
        "entry_kind": {
          "$ref": "lock.json#/$defs/EntryKind",
          "description": "Resolved entry asset kind."
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "deleted"
          ],
          "description": "Schedule lifecycle status."
        },
        "paused_reason": {
          "type": "string",
          "description": "Reason the schedule was automatically paused."
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp.",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "description": "Last modification timestamp.",
          "format": "date-time"
        }
      },
      "x-extra": "ignore"
    },
    "ScheduleListResponse": {
      "description": "Schedules visible to the run principal in the session workspace.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "items": {
          "type": "array",
          "description": "Visible schedules.",
          "items": {
            "$ref": "#/$defs/ScheduleView"
          },
          "default": []
        }
      },
      "x-extra": "ignore"
    },
    "ScheduleOverlapPolicy": {
      "description": "How a schedule handles overlapping firings.",
      "enum": [
        "skip",
        "buffer_one"
      ]
    },
    "ScheduleErrorCode": {
      "description": "HTTP error codes returned by schedule kernel API operations; not Temporal ApplicationError types.",
      "enum": [
        "SCHEDULE_INVALID_CRON",
        "SCHEDULE_INTERVAL_TOO_SHORT",
        "SCHEDULE_INVALID_TIMEZONE",
        "SCHEDULE_QUOTA_EXCEEDED",
        "SCHEDULE_NOT_FOUND"
      ]
    }
  }
}
