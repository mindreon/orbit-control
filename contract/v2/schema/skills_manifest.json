{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.mindreon.com/contract/v2/skills_manifest.json",
  "description": "skills.json of an agent bundle.",
  "x-exports": ["SkillsManifest"],
  "$defs": {
    "SkillsManifest": {
      "description": "skills.json of an agent bundle: the order of the skills and the references to catalog skills. Skill directories of the bundle that are not listed still load, after the listed ones.",
      "type": "object",
      "additionalProperties": false,
      "required": ["skills"],
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkillEntry"
          },
          "description": "Skills in load order."
        }
      }
    },
    "SkillSource": {
      "description": "bundle: the skill is the directory skills/<name>/ of the bundle. catalog: the skill is a skill asset, resolved to an exact version when the run is locked.",
      "enum": ["bundle", "catalog"]
    },
    "SkillEntry": {
      "description": "One skill. A catalog entry needs id; a bundle entry has neither id nor version.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the skill, unique within the file."
        },
        "source": {
          "$ref": "#/$defs/SkillSource"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Catalog skill, publisher/name."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Semantic version or range such as ^2.1. An exact version pins the skill."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "catalog"
              }
            },
            "required": ["source"]
          },
          "then": {
            "required": ["id"]
          },
          "else": {
            "properties": {
              "id": false,
              "version": false
            }
          }
        }
      ]
    }
  }
}
