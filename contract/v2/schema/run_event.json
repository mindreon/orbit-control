{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.mindreon.com/contract/v2/run_event.json",
  "description": "The run event envelope orbit.event/v1 and the data of each event type.",
  "x-exports": [
    "RunEvent"
  ],
  "$defs": {
    "RunEvent": {
      "description": "Envelope orbit.event/v1 of every event of a run, published to NATS JetStream on run.<tenant>.<session>.<run> and projected to run_events. A frame is at most 64 KiB; larger content travels as a reference. data has the structure that type selects. SSE id and run_events.stream_seq are the JetStream stream sequence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "id",
        "ts",
        "tenant_id",
        "session_id",
        "run_id",
        "member",
        "segment",
        "attempt",
        "type",
        "data"
      ],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1,
          "description": "Envelope version."
        },
        "id": {
          "type": "string",
          "description": "Event id <run_id>:<member>:<seq>:<attempt>:<n>. n starts at 1 and increases within each emitter tuple; control uses attempt=0.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[0-9]+:[0-9]+:[1-9][0-9]*$"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Display order assigned by the publisher. Resumption uses the JetStream sequence, not this field."
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "description": "When the event was produced."
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Tenant that owns the run."
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "description": "Session the run belongs to."
        },
        "run_id": {
          "type": "string",
          "format": "uuid",
          "description": "Run the event belongs to."
        },
        "member": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "description": "Emitter member; main for a single-agent run. Control events use attempt=0; worker attempts start at 1."
        },
        "segment": {
          "type": "integer",
          "minimum": 0,
          "description": "Segment number the event belongs to; 0 for events outside any segment."
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "description": "Activity attempt that produced the event; 0 outside any segment. A new attempt supersedes unfinished content of lower attempts of the same segment."
        },
        "type": {
          "$ref": "#/$defs/EventType"
        },
        "data": {
          "type": "object",
          "description": "Payload; its structure is the $defs entry that matches type.",
          "x-extra": "ignore"
        },
        "trace": {
          "$ref": "#/$defs/EventTrace"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.started"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/RunStarted"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.status"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/RunStatus"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.completed"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/RunCompleted"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.failed"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/RunFailed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "segment.started"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/SegmentStarted"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "segment.ended"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/SegmentEnded"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "message.delta"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/MessageDelta"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "message.final"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/MessageFinal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reasoning.delta"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/ReasoningDelta"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool.call"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/ToolCall"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool.result"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/ToolResult"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sandbox.output"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/SandboxOutput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "artifact.created"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/ArtifactCreated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "artifact.updated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/ArtifactUpdated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "interaction.requested"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/InteractionRequested"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "interaction.resolved"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/InteractionResolved"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "team.task.created"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/TeamTaskCreated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "team.task.updated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/TeamTaskUpdated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "team.member.status"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/TeamMemberStatus"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "team.message"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/TeamMessage"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "usage.update"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/UsageUpdate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "error"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/ErrorData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sandbox.restored"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/SandboxRestored"
              }
            }
          }
        }
      ],
      "x-extra": "ignore"
    },
    "EventType": {
      "description": "Event type. It selects the structure of data.",
      "enum": [
        "run.started",
        "run.status",
        "run.completed",
        "run.failed",
        "segment.started",
        "segment.ended",
        "message.delta",
        "message.final",
        "reasoning.delta",
        "tool.call",
        "tool.result",
        "sandbox.output",
        "artifact.created",
        "artifact.updated",
        "interaction.requested",
        "interaction.resolved",
        "team.task.created",
        "team.task.updated",
        "team.member.status",
        "team.message",
        "usage.update",
        "error",
        "sandbox.restored"
      ]
    },
    "RunState": {
      "description": "Lifecycle state of a run. queued: accepted, waiting for its turn. running: a segment executes. waiting_input: parked on ask_user. waiting_approval: parked on a tool approval or an uncertain effect. paused: suspended until explicitly resumed. The rest are terminal: succeeded, failed, cancelled, budget_exhausted, timed_out.",
      "enum": [
        "queued",
        "running",
        "waiting_input",
        "waiting_approval",
        "paused",
        "succeeded",
        "failed",
        "cancelled",
        "budget_exhausted",
        "timed_out"
      ]
    },
    "EventTrace": {
      "description": "Trace context of the event.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "span_id"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "W3C trace ID."
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "W3C span ID."
        }
      },
      "x-extra": "ignore"
    },
    "RunStarted": {
      "description": "A run left the queue and began.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_id",
        "entry_kind"
      ],
      "properties": {
        "lock_id": {
          "type": "string",
          "description": "Lock the run executes.",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "entry_kind": {
          "$ref": "lock.json#/$defs/EntryKind"
        }
      },
      "x-extra": "ignore"
    },
    "RunStatus": {
      "description": "The run changed state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/RunState"
        },
        "reason": {
          "type": "string",
          "description": "Why, for example the tool or question the run waits on."
        }
      },
      "x-extra": "ignore"
    },
    "RunCompleted": {
      "description": "The run ended without a failure. status is succeeded, cancelled, budget_exhausted or timed_out; a failure is run.failed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "description": "Terminal state of the run.",
          "enum": [
            "succeeded",
            "cancelled",
            "budget_exhausted",
            "timed_out"
          ]
        },
        "final_message_id": {
          "type": "string",
          "description": "Last assistant message of the run, when there is one.",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        }
      },
      "x-extra": "ignore"
    },
    "RunFailed": {
      "description": "The run ended with state failed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable machine-readable error code.",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "description": "Human-readable message, without secrets."
        }
      },
      "x-extra": "ignore"
    },
    "SegmentStarted": {
      "description": "An attempt of a segment began. Consumers drop unfinished content of lower attempts of the same segment. Finalized messages are retained; the final from an older attempt takes precedence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_checkpoint_version"
      ],
      "properties": {
        "expected_checkpoint_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Checkpoint version the segment starts from."
        }
      },
      "x-extra": "ignore"
    },
    "SegmentEnded": {
      "description": "A segment committed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checkpoint_version"
      ],
      "properties": {
        "status": {
          "$ref": "segment_result.json#/$defs/SegmentStatus"
        },
        "yield_reason": {
          "$ref": "segment_result.json#/$defs/YieldReason"
        },
        "checkpoint_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Checkpoint version after the commit."
        },
        "usage": {
          "type": "array",
          "description": "Per-model usage over this segment, one entry for each model used.",
          "items": {
            "$ref": "common.json#/$defs/Usage"
          },
          "default": []
        }
      },
      "x-extra": "ignore"
    },
    "MessageDelta": {
      "description": "A chunk of assistant output. Not persisted. message_id = uuid5(NAMESPACE_URL, \"orbit:message:<run>/<member>/<seq>/<k>\"), where k advances from zero or after the current message has a final; otherwise an unfinished call, retry, or recovery reuses k. Calls without visible output have no final and do not advance k. Delta and final of the same message share this id. A retry final replaces all earlier deltas for its id. Only the last in-flight message may lack a final in an attempt that failed, was cancelled, or ended without segment.ended (for example a transient failure or a worker crash).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "delta"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "description": "Message the chunk belongs to.",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "delta": {
          "type": "string",
          "description": "Text to append."
        }
      },
      "x-extra": "ignore"
    },
    "MessageFinal": {
      "description": "The complete assistant message, persisted in run_events. text may be empty when only reasoning was visible. message_id = uuid5(NAMESPACE_URL, \"orbit:message:<run>/<member>/<seq>/<k>\"), where k advances from zero or after the current message has a final; otherwise an unfinished call, retry, or recovery reuses k. Calls without visible output have no final and do not advance k. Delta and final of the same message share this id. A retry final replaces all earlier deltas for its id. Only the last in-flight message may lack a final in an attempt that failed, was cancelled, or ended without segment.ended (for example a transient failure or a worker crash).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "description": "Message identifier.",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "text": {
          "type": "string",
          "description": "Full text when it fits in the frame."
        },
        "content_ref": {
          "type": "string",
          "description": "Object store reference of the full content when it does not.",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "text"
              ]
            }
          },
          "then": {
            "required": [
              "content_ref"
            ]
          }
        }
      ],
      "x-extra": "ignore"
    },
    "ReasoningDelta": {
      "description": "A chunk of model reasoning. Not persisted; clients may exclude it. message_id = uuid5(NAMESPACE_URL, \"orbit:message:<run>/<member>/<seq>/<k>\"), where k advances from zero or after the current message has a final; otherwise an unfinished call, retry, or recovery reuses k. Calls without visible output have no final and do not advance k. Delta and final of the same message share this id. A retry final replaces all earlier deltas for its id. Only the last in-flight message may lack a final in an attempt that failed, was cancelled, or ended without segment.ended (for example a transient failure or a worker crash).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delta",
        "message_id"
      ],
      "properties": {
        "delta": {
          "type": "string",
          "description": "Text to append."
        },
        "message_id": {
          "type": "string",
          "description": "Message from the same model call as this reasoning.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        }
      },
      "x-extra": "ignore"
    },
    "ToolCall": {
      "description": "The agent called a tool.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "tool",
        "args_preview",
        "effect_class"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "description": "Identifier of the call, matched by the tool.result.",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "tool": {
          "type": "string",
          "description": "Tool name.",
          "minLength": 1
        },
        "args_preview": {
          "type": "string",
          "description": "Arguments, truncated and with secrets masked."
        },
        "effect_class": {
          "$ref": "common.json#/$defs/EffectClass"
        }
      },
      "x-extra": "ignore"
    },
    "ToolResult": {
      "description": "A tool call finished.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "ok",
        "preview"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "description": "Call this answers.",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "ok": {
          "type": "boolean",
          "description": "Whether the tool succeeded."
        },
        "preview": {
          "type": "string",
          "description": "Result, truncated and with secrets masked."
        },
        "result_ref": {
          "type": "string",
          "description": "Object store reference of the full result when it was truncated.",
          "minLength": 1
        }
      },
      "x-extra": "ignore"
    },
    "SandboxOutput": {
      "description": "A chunk of terminal output from the sandbox. Not persisted in run_events.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "stream",
        "text"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "description": "Tool call that produced the output.",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "stream": {
          "description": "Output stream.",
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "text": {
          "type": "string",
          "description": "The output chunk."
        }
      },
      "x-extra": "ignore"
    },
    "ArtifactCreated": {
      "description": "A new file appeared in the run output.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact"
      ],
      "properties": {
        "artifact": {
          "$ref": "common.json#/$defs/Artifact"
        }
      },
      "x-extra": "ignore"
    },
    "ArtifactUpdated": {
      "description": "A file in the run output changed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact"
      ],
      "properties": {
        "artifact": {
          "$ref": "common.json#/$defs/Artifact"
        }
      },
      "x-extra": "ignore"
    },
    "InteractionRequested": {
      "description": "The run waits for a decision.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction"
      ],
      "properties": {
        "interaction": {
          "$ref": "interaction.json#/$defs/InteractionRequest"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the request expires and counts as denied."
        }
      },
      "x-extra": "ignore"
    },
    "InteractionResolved": {
      "description": "A decision arrived, or the request expired.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_id",
        "decision",
        "actor"
      ],
      "properties": {
        "interaction_id": {
          "type": "string",
          "description": "Interaction that was resolved.",
          "minLength": 1,
